# --- Access -------------------------------------------------------------------
# APP_SESSION_SECRET signs the login cookie; at least 16 characters, random.
APP_SESSION_SECRET=

# The seller accounts, as a JSON array on one line. Each entry binds a login to
# the option id that seller has on the Pipedrive deal field "Affärens säljare"
# (read the ids from GET /dealFields). Hashes come from `npm run hash-password`.
# Example:
# APP_USERS=[{"username":"filippa","name":"Filippa","sellerOptionId":72,"passwordHash":"scrypt$..."}]
APP_USERS=

# --- Storage ------------------------------------------------------------------
# Neon Postgres (Vercel Marketplace). Required on Vercel: run history and the
# supplier registry live here because the function filesystem is read-only.
# Unset locally means .data/*.jsonl files are used instead.
DATABASE_URL=

# Vercel Blob, the staging area for audio uploads (browser -> Blob -> Pipedrive).
BLOB_READ_WRITE_TOKEN=

# --- Pipedrive ----------------------------------------------------------------
# Credentials stay server-side.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_API_BASE_URL=https://api.pipedrive.com/v1
PIPEDRIVE_API_V2_BASE_URL=https://api.pipedrive.com/api/v2
PIPEDRIVE_DEFAULT_CURRENCY=SEK

# The Pipedrive user who owns new prospects (the back-office/QC inbox) and
# receives the "skicka avtal för signering" tasks. Unset = the token's user.
PIPEDRIVE_LEAD_OWNER_USER_ID=

# Comma-separated user ids of the technicians who take meetings. Free slots are
# computed against their calendars and a booking is assigned to one of them.
# Unset = every user's activities block a slot; the token's user owns bookings.
PIPEDRIVE_TECHNICIAN_USER_IDS=

# Account-specific custom *deal* field API keys (40-char hashes), read from
# GET /dealFields on the target account — do not guess or retype. Leads inherit
# these fields, so the same keys are written on a prospect. All six are required
# before a prospect can be created: a missing key would silently drop the value.
PIPEDRIVE_FIELD_FAKTURA_START=
PIPEDRIVE_FIELD_FAKTURAGRUPP=
PIPEDRIVE_FIELD_VIKTIGAST_FOR_KUNDEN=
PIPEDRIVE_FIELD_AFFARENS_SALJARE=
# "Underlag" — enum with exactly these options: Ljudfil uppladdad,
# Digital signering krävs, Väntar på signering, Avtal signerat.
PIPEDRIVE_FIELD_UNDERLAG=
# "Ursprunglig säljare" — enum with the same four options as Affärens säljare.
PIPEDRIVE_FIELD_URSPRUNGLIG_SALJARE=

# Custom *organization* field keys, from GET /organizationFields. Optional: an
# unset key skips that field instead of failing the request, but the identity
# number must be mapped for duplicate detection and auto-fill to work.
PIPEDRIVE_FIELD_ORG_NUMBER=
PIPEDRIVE_FIELD_ORG_WEBSITE=

# --- Meeting slots ------------------------------------------------------------
# Working window (Mon–Fri), slot step, meeting length and the earliest bookable
# slot counted from now. All in Swedish local time / minutes.
MEETING_WORKING_HOURS_START=08:00
MEETING_WORKING_HOURS_END=17:00
MEETING_SLOT_STEP_MINUTES=30
MEETING_DURATION_MINUTES=60
MEETING_MIN_LEAD_MINUTES=60

# Local-only fallback for run history when DATABASE_URL is unset.
HISTORY_FILE_PATH=
