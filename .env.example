# Access gate for the internal portal. Both are required to log in.
# APP_SESSION_SECRET must be at least 16 characters; generate a random one.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=

# Pipedrive credentials must stay server-side.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_API_BASE_URL=https://api.pipedrive.com/v1
# Public general-availability or specific-times link copied from Pipedrive Scheduler.
PIPEDRIVE_SCHEDULER_URL=

# Optional default IDs. Do not guess these; get them from the client account.
PIPEDRIVE_DEFAULT_PIPELINE_ID=
PIPEDRIVE_DEFAULT_STAGE_ID=
PIPEDRIVE_DEFAULT_CURRENCY=SEK

# Account-specific Pipedrive custom field API keys (40-char hashes).
# Read them from GET /dealFields on the target account — do not guess or retype.
# All three are required before a deal can be created: a missing key would
# silently drop the value from the deal, so deal creation fails instead.
PIPEDRIVE_FIELD_FAKTURA_START=
PIPEDRIVE_FIELD_FAKTURAGRUPP=
PIPEDRIVE_FIELD_VIKTIGAST_FOR_KUNDEN=

# Where run history is stored. Defaults to ./.data/history.json
HISTORY_FILE_PATH=
